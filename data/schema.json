{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beejmaxx/awesome-agent-runtimes/blob/main/data/schema.json",
  "title": "Awesome Agent Runtimes source catalog",
  "type": "object",
  "required": ["schema_version", "categories", "projects"],
  "properties": {
    "schema_version": {"const": 1},
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "repo", "category", "description", "deployment", "tags"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "category": {"type": "string"},
          "description": {"type": "string", "pattern": "\\.$"},
          "deployment": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["library", "local", "self-hosted", "managed"]}
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
